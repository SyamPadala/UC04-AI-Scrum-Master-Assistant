# UC-04 AI Scrum Master Assistant — environment template
#
# Copy this file to `.env` and fill in the values as the setup checklist
# (docs/SETUP-CHECKLIST.md) produces them. `.env` is gitignored: never commit it,
# never paste its contents into chat.
#
# Which account is which — fill this in, it saves time later:
#   Google / GCP + Gemini : ....................................
#   Microsoft 365 sandbox : ....................................
#   Jira Cloud            : ....................................
#   Azure DevOps          : ....................................

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Log instead of sending real Teams messages. Keep true until the bot is
# registered and installed (checklist items 2-4).
DRY_RUN=true

# ----------------------------------------------------------------------------
# LLM — provider adapter (A12). Delivered provider: gemini.
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=

# Only needed if LLM_PROVIDER is switched
ANTHROPIC_API_KEY=

AGENT1_MAX_TOOL_ITERATIONS=3
AGENT1_TIMEOUT_MS=20000
AGENT1_MAX_RETRIES=2
AGENT2_MAX_TOOL_ITERATIONS=4
AGENT2_TIMEOUT_MS=45000
AGENT2_MAX_RETRIES=2

# ----------------------------------------------------------------------------
# Microsoft 365 — checklist items 1-8
# ----------------------------------------------------------------------------
# Item 1: sandbox tenant
M365_TENANT_ID=
M365_TENANT_DOMAIN=

# Item 3: bot registration (Teams Developer Portal)
BOT_APP_ID=
BOT_APP_PASSWORD=

# Item 8: Entra app for Graph
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Item 5: Teams team + stakeholder channel
TEAMS_TEAM_ID=
STAKEHOLDER_CHANNEL_ID=

# Item 6: SharePoint tracker destination
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=

# Item 7: Excel Online tracker destination
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
EXCEL_WORKSHEET=Standup

# ----------------------------------------------------------------------------
# Jira Cloud — checklist item 9
# ----------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_STORY_POINTS_FIELD=
JIRA_PROJECT_KEY=

# ----------------------------------------------------------------------------
# Azure DevOps — checklist item 10
# ----------------------------------------------------------------------------
ADO_ORG_URL=
ADO_PROJECT=
ADO_PAT=

# ----------------------------------------------------------------------------
# Google Cloud — checklist items 11-14
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=api-project-631634995359
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_DATABASE=(default)

# Shared secret required on POST /tick
TICK_SHARED_SECRET=

# ----------------------------------------------------------------------------
# Defaults
# ----------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_GRACE_MINUTES=120
SEND_CONCURRENCY=4
MOCK_TRACKER_PATH=./.data/tracker.json

# Admin page (SPEC-008)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
PUBLIC_BASE_URL=
JIRA_STANDUP_ISSUE_KEY=
